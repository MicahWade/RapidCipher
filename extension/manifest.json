  {
    "manifest_version": 3,
    "name": "RapidCipher",
    "version": "1.0",
    "description": "Connects to the RapidCipher desktop app.",
    "icons": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "action": {
      "default_popup": "popup.html",
      "default_icon": "icons/icon-48.png"
    },
    "background": {
      "scripts": ["background.js"]
    },
    "permissions": [
      "nativeMessaging",
      "storage",
      "clipboardWrite"
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "rapidcipher@gemini.dev",
        "strict_min_version": "109.0"
      }
    }
  }

